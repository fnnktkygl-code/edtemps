{
  "name": "edtemps",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Socle de répartition des classes et d'emplois du temps pour établissements scolaires français.",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "packages/domain",
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "npm run dev --workspace=@edtemps/web",
    "db:migrate": "tsx apps/api/src/migrate.ts",
    "check": "tsc --noEmit && npm run check --workspace=@edtemps/web",
    "lint": "eslint . --max-warnings=9999",
    "lint:css": "stylelint \"apps/web/src/**/*.css\"",
    "test": "tsx --test packages/domain/test/dispatch.test.ts packages/domain/test/load.test.ts packages/domain/test/timetabling.test.ts packages/domain/test/substitutions.test.ts packages/domain/test/pronote_dpo.test.ts apps/api/test/siecle-import.test.ts",
    "build:api": "tsc --noEmit",
    "build": "npm run check && npm run build --workspace=@edtemps/web"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.3",
    "adm-zip": "^0.6.0",
    "dotenv": "^16.6.1",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "concurrently": "^9.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.9.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0"
  }
}
