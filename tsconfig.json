{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["apps/api/src/**/*.ts", "apps/api/test/**/*.ts", "packages/domain/src/**/*.ts", "packages/domain/test/**/*.ts"]
}
